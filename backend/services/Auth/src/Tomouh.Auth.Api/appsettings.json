{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "MongoDb": "",
    "AppSystemSqlDb": ""
  },

  "MongoDb": {
    "DatabaseName": ""
  },

  "AuthenticationSettings": {
    "JwtSettings": {
      "TokenExpirationInMinutes": 120,
      "Issuer": "TomouhAuthApi",
      "Audience": "TomouhClients"
    },
    "PasswordSettings": {
      "MinimumLength": 8,
      "MaximumLength": 64,
      "EnforceUppercase": true,
      "EnforceLowercase": true,
      "EnforceDigit": true,
      "EnforceDelimiter": true
    },

    "ExternalAuth": {
      "Google": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "GitHub": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "ClientId": "",
        "ClientSecret": "",
        "TenantId": "common"
      }
    }
  },

  "RedisOptions": {
    "Host": "localhost",
    "Port": 6379,
    "Password": "",
    "UseSsl": false,
    "AbortOnConnectFail": false,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "InstanceName": ""
  },

  "EmailSettings": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "From": ""
  }
}